{
  "name": "skillcity",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "audit:employees": "tsx scripts/audit-employee-data.ts",
    "audit:academic-advisors": "tsx scripts/audit-academic-advisor-data.ts",
    "audit:labs": "tsx scripts/audit-labs-data.ts",
    "audit:skill-studio": "tsx scripts/audit-skill-studio-data.ts",
    "audit:career-hub": "tsx scripts/audit-career-hub-data.ts",
    "audit:core-operations": "tsx scripts/audit-core-operations-data.ts",
    "audit:payment-references": "tsx scripts/audit-payment-references.ts",
    "audit:v2-governance": "tsx scripts/audit-v2-role-governance.ts",
    "audit:v2-communications": "tsx scripts/audit-v2-internal-communications.ts",
    "audit:v2-sia": "tsx scripts/audit-v2-sia-readiness.ts",
    "audit:communications": "tsx scripts/audit-communications-automation-data.ts",
    "launch:check": "tsx scripts/launch-readiness.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
    "@prisma/client": "^6.16.3",
    "@radix-ui/react-slot": "latest",
    "@tanstack/react-query": "latest",
    "bcryptjs": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "framer-motion": "latest",
    "gsap": "^3.15.0",
    "lucide-react": "latest",
    "next": "^16.3.7",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "resend": "latest",
    "tailwind-merge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/bcryptjs": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "latest",
    "eslint": "latest",
    "eslint-config-next": "^16.3.7",
    "postcss": "latest",
    "prisma": "^6.16.3",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  }
}
