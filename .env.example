# Server-only variables. Set real values only in approved environment secret management.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
AUTH_SECRET="replace-with-a-strong-random-secret"
# Optional one-time admin bootstrap. Generate INITIAL_ADMIN_PIN_HASH with bcrypt.
INITIAL_ADMIN_MOBILE=""
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PIN_HASH=""
# One-time CEO bootstrap. Mobile defaults to 8089239823 in application code; only store the bcrypt hash here.
INITIAL_CEO_PIN_HASH=""
RESEND_API_KEY=""
WHATSAPP_API_URL=""
WHATSAPP_ACCESS_TOKEN=""
# Reserved legacy placeholder; the current shared rate limiter uses PostgreSQL.
REDIS_URL=""
# Browser-visible canonical application origin; never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_RESPONSES_URL="https://api.openai.com/v1/responses"
AI_PROVIDER_TIMEOUT_MS="30000"
ANALYTICS_TIME_ZONE="Asia/Kolkata"
# Server-only private document delivery. The gateway must validate token signatures and expiry.
PRIVATE_DOCUMENT_PROVIDER=""
PRIVATE_DOCUMENT_GATEWAY_URL=""
PRIVATE_DOCUMENT_SIGNING_SECRET=""
PRIVATE_DOCUMENT_URL_TTL_SECONDS="60"
