  conversationId String           @db.Uuid
  messageId      String           @db.Uuid
  rating         AIFeedbackRating
  comment        String?          @db.Text
  createdAt      DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message AIMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([conversationId])
  @@index([rating])
}

model TokenUsage {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  conversationId String?     @db.Uuid
  provider       AIProvider
  model          String      @db.VarChar(120)
  inputTokens    Int         @default(0)
  outputTokens   Int         @default(0)
  totalTokens    Int         @default(0)
  createdAt      DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([conversationId])
}

model PipelineStage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  order     Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]

  @@unique([order])
  @@index([active])
}

model LeadSource {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]
}

model LeadTag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(80)
  color     String?  @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads LeadTagOnLead[]
}

model LeadTagOnLead {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  tagId     String   @db.Uuid
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  LeadTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([leadId, tagId])
}

model Lead {
  id                  String       @id @default(uuid()) @db.Uuid
  name                String       @db.VarChar(160)
  email               String?      @db.VarChar(255)
  phone               String       @db.VarChar(40)
  whatsapp            String?      @db.VarChar(40)
  city                String?      @db.VarChar(120)
  state               String?      @db.VarChar(120)
  programInterestedId String?      @db.Uuid
  sourceId            String?      @db.Uuid
  pipelineStageId     String       @db.Uuid
  assignedToId        String?      @db.Uuid
  ownerId             String?      @db.Uuid
  priority            LeadPriority @default(MEDIUM)
  status              LeadStatus   @default(OPEN)
  notes               String?      @db.Text
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  convertedAt         DateTime?

  programInterested Program? @relation(fields: [programInterestedId], references: [id], onDelete: SetNull)
  source LeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  pipelineStage PipelineStage @relation(fields: [pipelineStageId], references: [id], onDelete: Restrict)
  assignedTo User? @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  owner User? @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities LeadActivity[]
  leadNotes LeadNote[]
  tags LeadTagOnLead[]
  counsellingSessions CounsellingSession[]
  applications AdmissionApplication[]
  invoices FeeInvoice[]
  referrals Referral[]
  communicationLogs CommunicationLog[]

  @@index([pipelineStageId, status])
  @@index([assignedToId])
  @@index([programInterestedId])
  @@index([phone])
  @@index([email])
}

model LeadActivity {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  actorId   String?  @db.Uuid
  type      String   @db.VarChar(120)
  summary   String   @db.Text
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([actorId])
}

model LeadNote {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  authorId  String?  @db.Uuid
  note      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId])
}

model CounsellingSession {
  id             String             @id @default(uuid()) @db.Uuid
  leadId         String             @db.Uuid
  batchId        String?            @db.Uuid
  counsellorId   String?            @db.Uuid
  scheduledAt    DateTime
  outcome        CounsellingOutcome @default(SCHEDULED)
  notes          String?            @db.Text
  nextFollowUpAt DateTime?
  meetingLink    String?            @db.VarChar(600)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  batch Batch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  counsellor User? @relation("CounsellorSessions", fields: [counsellorId], references: [id], onDelete: SetNull)

  @@index([scheduledAt])
  @@index([leadId])
  @@index([counsellorId])
}

model AdmissionApplication {
  id        String            @id @default(uuid()) @db.Uuid
  leadId    String            @db.Uuid
  studentId String?           @db.Uuid
  programId String            @db.Uuid
  status    ApplicationStatus @default(DRAFT)
  data      Json?
  submittedAt DateTime?
  reviewedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  student User? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  documents StudentDocument[]
  studentLoginCredentials StudentLoginCredential[]
  whatsAppMessageLogs WhatsAppMessageLog[]

  @@index([leadId])
  @@index([studentId])
  @@index([programId, status])
}

model StudentLoginCredential {
  id             String                  @id @default(uuid()) @db.Uuid
  userId         String                  @db.Uuid
  applicationId  String?                 @db.Uuid
  whatsapp       String                  @unique @db.VarChar(40)
  pinHash        String
  status         StudentCredentialStatus @default(ACTIVE)
  temporary      Boolean                 @default(true)
  mustResetPin   Boolean                 @default(true)
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  generatedById  String?                 @db.Uuid
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  user User @relation("StudentLoginCredentials", fields: [userId], references: [id], onDelete: Cascade)
  application AdmissionApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  generatedBy User? @relation("GeneratedStudentCredentials", fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([applicationId])
  @@index([status, expiresAt])
  @@index([generatedById])
}

model WhatsAppMessageLog {
  id            String                @id @default(uuid()) @db.Uuid
  to            String                @db.VarChar(40)
  template      String                @db.VarChar(120)
  message       String                @db.Text
  status        WhatsAppMessageStatus @default(QUEUED)
  provider      String?               @db.VarChar(80)
  providerRef   String?               @db.VarChar(160)
  applicationId String?               @db.Uuid
  userId        String?               @db.Uuid
  metadata      Json?
  sentAt        DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  application AdmissionApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([to])
  @@index([status])
  @@index([applicationId])
  @@index([userId])
}

model StudentDocument {
  id            String         @id @default(uuid()) @db.Uuid
  applicationId String?        @db.Uuid
  studentId     String?        @db.Uuid
  type          DocumentType
  title         String         @db.VarChar(180)
  fileUrl       String         @db.VarChar(700)
  status        DocumentStatus @default(PENDING)
  rejectionReason String?      @db.Text
  verifiedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  application AdmissionApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  student User? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([studentId, status])
}

model FeeInvoice {
  id          String        @id @default(uuid()) @db.Uuid
  leadId      String?       @db.Uuid
  studentId   String?       @db.Uuid
  programId   String?       @db.Uuid
  batchId     String?       @db.Uuid
  invoiceNo   String        @unique @db.VarChar(80)
  subtotal    Int
  discount    Int           @default(0)
  scholarship Int           @default(0)
  gst         Int           @default(0)
  total       Int
  status      InvoiceStatus @default(DRAFT)
  dueAt       DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  student User? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  batch Batch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]
  commissionRecords CommissionRecord[]

  @@index([leadId])
  @@index([studentId])
  @@index([status])
}

model PaymentTransaction {
  id          String          @id @default(uuid()) @db.Uuid
  invoiceId   String          @db.Uuid
  studentId   String?         @db.Uuid
  provider    PaymentProvider
  status      PaymentStatus   @default(INITIATED)
  amount      Int
  providerRef String?         @db.VarChar(160)
  metadata    Json?
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  student User? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([studentId])
  @@index([provider, status])
}

model CommissionRecord {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  programId   String?          @db.Uuid
  invoiceId   String?          @db.Uuid
  type        CommissionType
  status      CommissionStatus @default(PENDING)
  baseAmount  Int              @default(0)
  rate        Int?
  amount      Int
  notes       String?          @db.Text
  approvedById String?         @db.Uuid
  approvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User @relation("CommissionOwner", fields: [userId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  invoice FeeInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  approvedBy User? @relation("CommissionApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([programId])
  @@index([invoiceId])
}

model Referral {
  id          String   @id @default(uuid()) @db.Uuid
  referrerId  String   @db.Uuid
  leadId      String?  @db.Uuid
  programId   String?  @db.Uuid
  code        String   @unique @db.VarChar(80)
  qrPayload   String?  @db.VarChar(700)
  convertedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  referrer User @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([referrerId])
  @@index([leadId])
}

model EnrollmentLog {
  id           String   @id @default(uuid()) @db.Uuid
  studentId    String   @db.Uuid
  batchId      String?  @db.Uuid
  enrollmentId String?  @db.Uuid
  action       String   @db.VarChar(140)
  metadata     Json?
  createdAt    DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch Batch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  enrollment StudentEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([batchId])
  @@index([enrollmentId])
}

model CommunicationLog {
  id          String                 @id @default(uuid()) @db.Uuid
  leadId      String?                @db.Uuid
  userId      String?                @db.Uuid
  channel     CommunicationChannel
  status      CommunicationLogStatus @default(DRAFT)
  subject     String?                @db.VarChar(180)
  message     String                 @db.Text
  scheduledAt DateTime?
  sentAt      DateTime?
  metadata    Json?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@index([channel, status])
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  type      NotificationType
  title     String             @db.VarChar(180)
  message   String             @db.Text
  status    NotificationStatus @default(UNREAD)
  actionUrl String?            @db.VarChar(500)
  createdAt DateTime           @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([createdAt])
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(80)
  description String?   @db.VarChar(240)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users UserRole[]
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  userAgent    String?   @db.VarChar(500)
  ipAddress    String?   @db.VarChar(80)
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailOTP {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String?    @db.Uuid
  email      String     @db.VarChar(255)
  codeHash   String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String   @db.VarChar(120)
  entity    String?  @db.VarChar(120)
  entityId  String?  @db.VarChar(120)
  metadata  Json?
  ipAddress String?  @db.VarChar(80)
  userAgent String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
