  ownerUserId    String?              @db.Uuid
  institutionId  String               @db.Uuid
  divisionId     String?              @db.Uuid
  districtId     String?              @db.Uuid
  campusId       String?              @db.Uuid
  departmentId   String?              @db.Uuid
  createdById    String               @db.Uuid
  retentionUntil DateTime?
  archivedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  owner             User?                     @relation("CoreDocumentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  institution       Institution               @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  division          Division?                 @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  district          District?                 @relation(fields: [districtId], references: [id], onDelete: SetNull)
  campus            Campus?                   @relation(fields: [campusId], references: [id], onDelete: SetNull)
  department        Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
