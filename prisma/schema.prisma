model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(120)
  email        String     @unique @db.VarChar(255)
  passwordHash String
  status       UserStatus @default(PENDING_EMAIL_VERIFICATION)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles                         UserRole[]
  sessions                      Session[]
  emailOtps                     EmailOTP[]
  passwordResetTokens           PasswordResetToken[]
  auditLogs                     AuditLog[]
  enrollments                   StudentEnrollment[]
  progress                      StudentProgress[]
  announcements                 Announcement[]
  notifications                 Notification[]
  authoredBlueprints            Blueprint[]
  contentLibraryItems           ContentLibrary[]
  trainerAssignments            TrainerAssignment[]              @relation("TrainerAssignments")
  directorAnnouncements         DirectorAnnouncement[]
  directorActivityLogs          DirectorActivityLog[]
  dailyLearningSessions         DailyLearningSession[]
  studentReflections            StudentReflection[]
  submissions                   Submission[]
  submissionReviews             SubmissionReview[]               @relation("SubmissionReviewer")
  quizAttempts                  QuizAttempt[]
  assessmentResults             AssessmentResult[]
  aiConversations               AIConversation[]
  aiMessages                    AIMessage[]
  aiUsageLogs                   AIUsageLog[]
  aiFeedback                    AIFeedback[]
  tokenUsage                    TokenUsage[]
  assignedLeads                 Lead[]                           @relation("LeadAssignee")
  ownedLeads                    Lead[]                           @relation("LeadOwner")
  counsellingSessions           CounsellingSession[]             @relation("CounsellorSessions")
  admissionApplications         AdmissionApplication[]
  studentDocuments              StudentDocument[]
  feeInvoices                   FeeInvoice[]
  paymentTransactions           PaymentTransaction[]
  commissionRecords             CommissionRecord[]               @relation("CommissionOwner")
  approvedCommissions           CommissionRecord[]               @relation("CommissionApprover")
  referrals                     Referral[]
  enrollmentLogs                EnrollmentLog[]
  communicationLogs             CommunicationLog[]
  leadActivities                LeadActivity[]
  leadNotes                     LeadNote[]
  attendanceSessions            AttendanceSession[]              @relation("AttendanceTrainer")
  attendanceRecords             AttendanceRecord[]               @relation("AttendanceStudent")
  trainerFeedbackGiven          TrainerFeedback[]                @relation("TrainerFeedbackTrainer")
  trainerFeedbackReceived       TrainerFeedback[]                @relation("TrainerFeedbackStudent")
  reviewComments                ReviewComment[]                  @relation("ReviewCommentTrainer")
  trainerResources              Resource[]                       @relation("TrainerResources")
  trainerAnnouncements          TrainerAnnouncement[]            @relation("TrainerAnnouncements")
  studentConcernsRaised         StudentConcern[]                 @relation("StudentConcernTrainer")
  studentConcerns               StudentConcern[]                 @relation("StudentConcernStudent")
  reviewQueueItems              ReviewQueue[]                    @relation("ReviewQueueTrainer")
  reviewQueueAsStudent          ReviewQueue[]
  studentPortfolio              StudentPortfolio?
  portfolioProjects             PortfolioProject[]               @relation("PortfolioProjectStudent")
  approvedPortfolioProjects     PortfolioProject[]               @relation("PortfolioProjectApprover")
  verifiedSkills                VerifiedSkill[]                  @relation("VerifiedSkillStudent")
  skillVerifierRecords          VerifiedSkill[]                  @relation("VerifiedSkillVerifier")
  certificates                  Certificate[]                    @relation("CertificateStudent")
  approvedCertificates          Certificate[]                    @relation("CertificateApprover")
  achievements                  Achievement[]                    @relation("AchievementStudent")
  publishedAchievements         Achievement[]                    @relation("AchievementPublisher")
  resumeProfiles                ResumeProfile[]
  placementProfile              PlacementProfile?
  internships                   Internship[]                     @relation("InternshipStudent")
  mentoredInternships           Internship[]                     @relation("InternshipMentor")
  founderProfile                FounderProfile?
  careerMilestones              CareerMilestone[]
  communityGroupsCreated        CommunityGroup[]                 @relation("CommunityGroupCreator")
  communityMemberships          CommunityMembership[]
  communityPosts                CommunityPost[]
  communityComments             CommunityComment[]
  communityReactions            CommunityReaction[]
  eventRegistrations            EventRegistration[]
  challengeParticipations       ChallengeParticipation[]
  wallet                        Wallet?
  walletTransactions            WalletTransaction[]              @relation("WalletTransactionActor")
  marketplaceListings           MarketplaceListing[]             @relation("MarketplaceSeller")
  marketplaceApprovals          MarketplaceApproval[]            @relation("MarketplaceApprover")
  alumniProfile                 AlumniProfile?
  missionCompletions            MissionCompletion[]
  employeeProfile               Employee?
  careerApplicationsReviewed    CareerApplication[]              @relation("CareerApplicationReviewer")
  careerApplicationsAssigned    CareerApplication[]              @relation("CareerApplicationAssignedHr")
  careerInterviews              CareerInterview[]                @relation("CareerInterviewInterviewer")
  careerActivities              CareerApplicationActivity[]      @relation("CareerActivityActor")
  rmEvaluations                 RelationshipManagerDevelopment[] @relation("RMEvaluationActor")
  activationProfile             StudentActivationProfile?
  executiveReports              ExecutiveReport[]                @relation("ExecutiveReportCreator")
  executiveInsights             ExecutiveInsight[]               @relation("ExecutiveInsightOwner")
  platformAudits                PlatformAudit[]                  @relation("PlatformAuditActor")
  studentLoginCredentials       StudentLoginCredential[]         @relation("StudentLoginCredentials")
  generatedStudentCredentials   StudentLoginCredential[]         @relation("GeneratedStudentCredentials")
  whatsAppMessageLogs           WhatsAppMessageLog[]
  accessScopes                  UserAccessScope[]
  academicAdvisorAssignments    AcademicAdvisorAssignment[]      @relation("AcademicAdvisorStudent")
  advisorAssignmentsCreated     AcademicAdvisorAssignment[]      @relation("AcademicAdvisorAssignmentCreator")
  labsProductsCreated           LabsProduct[]                    @relation("LabsProductCreator")
  labsAssignmentsCreated        LabsProductAssignment[]          @relation("LabsProductAssignmentCreator")
  careerTalentProfile           CareerTalentProfile?
  careerOpportunityApplications CareerOpportunityApplication[]   @relation("CareerOpportunityApplicant")
  careerApplicationReviews      CareerOpportunityApplication[]   @relation("CareerOpportunityReviewer")
  careerReferrals               CareerReferral[]                 @relation("CareerReferralReferrer")
  careerEmployersCreated        CareerEmployer[]                 @relation("CareerEmployerCreator")
  careerEmployersVerified       CareerEmployer[]                 @relation("CareerEmployerVerifier")
  careerOpportunitiesCreated    CareerOpportunity[]              @relation("CareerOpportunityCreator")
  coreDocumentsOwned            CoreDocument[]                   @relation("CoreDocumentOwner")
  coreDocumentsCreated          CoreDocument[]                   @relation("CoreDocumentCreator")
  coreDocumentVersionsUploaded  CoreDocumentVersion[]            @relation("CoreDocumentVersionUploader")
  complianceRecordsCreated      ComplianceRecord[]               @relation("ComplianceRecordCreator")
  financeInvoicesCreated        FeeInvoice[]                     @relation("FinanceInvoiceCreator")
  financePaymentsRecorded       PaymentTransaction[]             @relation("FinancePaymentRecorder")
  financePaymentsVerified       PaymentTransaction[]             @relation("FinancePaymentVerifier")
  domainEvents                  DomainEvent[]                    @relation("DomainEventActor")
  communicationTemplatesCreated CommunicationTemplate[]          @relation("CommunicationTemplateCreator")
  communicationMessagesCreated  CommunicationMessage[]           @relation("CommunicationMessageCreator")
  communicationMessagesReceived CommunicationMessage[]           @relation("CommunicationMessageRecipient")
  automationRulesCreated        AutomationRule[]                 @relation("AutomationRuleCreator")
  aiAssistantsCreated           AIAssistant[]                    @relation("AIAssistantCreator")
  aiActionProposals             AIActionProposal[]               @relation("AIProposalActor")
  aiActionProposalReviews       AIActionProposal[]               @relation("AIProposalReviewer")
  internalChannelsCreated       InternalChannel[]                 @relation("InternalChannelCreator")
  internalChannelMemberships    InternalChannelMember[]
  internalMessagesAuthored      InternalMessage[]

  @@index([email])
  @@index([deletedAt])
}

model Program {
  id              String                  @id @default(uuid()) @db.Uuid
  institutionId   String?                 @db.Uuid
  divisionId      String?                 @db.Uuid
  campusId        String?                 @db.Uuid
  departmentId    String?                 @db.Uuid
  name            String                  @db.VarChar(160)
  slug            String                  @unique @db.VarChar(180)
  description     String                  @db.Text
  durationDays    Int
  status          ContentStatus           @default(DRAFT)
  thumbnail       String?                 @db.VarChar(500)
  category        String?                 @db.VarChar(120)
  feeType         ProgramFeeType          @default(PAID)
  admissionStatus ProgramAdmissionStatus  @default(CLOSED)
  displayOrder    Int                     @default(0)
  publicVisible   Boolean                 @default(false)
  operatingDomain ProgramOperatingDomain?
  skillStudioType SkillStudioProgramType?
  deliveryMode    ProgramDeliveryMode?
  learningModel   ProgramLearningModel?
  deletedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  journeys              Journey[]
  batches               Batch[]
  enrollments           StudentEnrollment[]
  announcements         Announcement[]
  blueprints            Blueprint[]
  contentLibraryItems   ContentLibrary[]
  calendarEvents        CalendarEvent[]
  directorAnnouncements DirectorAnnouncement[]
  leads                 Lead[]
  admissionApplications AdmissionApplication[]
  feeInvoices           FeeInvoice[]
  commissionRecords     CommissionRecord[]
  referrals             Referral[]
  certificates          Certificate[]
  portfolioPrograms     StudentPortfolioProgram[]
  communityGroups       CommunityGroup[]
  communityPosts        CommunityPost[]
  communityEvents       Event[]
  challenges            Challenge[]
  missions              Mission[]
  institution           Institution?              @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  division              Division?                 @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  campus                Campus?                   @relation(fields: [campusId], references: [id], onDelete: SetNull)
  department            Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([status])
  @@index([admissionStatus, publicVisible])
  @@index([displayOrder])
  @@index([institutionId])
  @@index([divisionId])
  @@index([campusId])
  @@index([departmentId])
  @@index([operatingDomain, status])
  @@index([skillStudioType, deliveryMode])
}

model Journey {
  id          String        @id @default(uuid()) @db.Uuid
  programId   String        @db.Uuid
  name        String        @db.VarChar(160)
  description String        @db.Text
  version     Int           @default(1)
  status      ContentStatus @default(DRAFT)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  program        Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  phases         JourneyPhase[]
  enrollments    StudentEnrollment[]
  announcements  Announcement[]
  blueprints     Blueprint[]
  calendarEvents CalendarEvent[]
  batches        Batch[]

  @@unique([programId, version])
  @@index([programId, status])
}

model JourneyPhase {
  id          String   @id @default(uuid()) @db.Uuid
  journeyId   String   @db.Uuid
  title       String   @db.VarChar(160)
  order       Int
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  journey Journey       @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  weeks   JourneyWeek[]

  @@unique([journeyId, order])
  @@index([journeyId])
}

model JourneyWeek {
  id         String   @id @default(uuid()) @db.Uuid
  phaseId    String   @db.Uuid
  weekNumber Int
  title      String   @db.VarChar(160)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  phase JourneyPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  days  JourneyDay[]

  @@unique([phaseId, weekNumber])
