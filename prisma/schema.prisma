model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(120)
  email        String     @unique @db.VarChar(255)
  passwordHash String
  status       UserStatus @default(PENDING_EMAIL_VERIFICATION)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles               UserRole[]
  sessions            Session[]
  emailOtps           EmailOTP[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  enrollments         StudentEnrollment[]
  progress            StudentProgress[]
  announcements       Announcement[]
  notifications       Notification[]
  authoredBlueprints  Blueprint[]
  contentLibraryItems ContentLibrary[]
  trainerAssignments  TrainerAssignment[] @relation("TrainerAssignments")
  directorAnnouncements DirectorAnnouncement[]
  directorActivityLogs DirectorActivityLog[]
  dailyLearningSessions DailyLearningSession[]
  studentReflections StudentReflection[]
  submissions Submission[]
  submissionReviews SubmissionReview[] @relation("SubmissionReviewer")
  quizAttempts QuizAttempt[]
  assessmentResults AssessmentResult[]
  aiConversations AIConversation[]
  aiMessages AIMessage[]
  aiUsageLogs AIUsageLog[]
  aiFeedback AIFeedback[]
  tokenUsage TokenUsage[]
  assignedLeads Lead[] @relation("LeadAssignee")
  ownedLeads Lead[] @relation("LeadOwner")
  counsellingSessions CounsellingSession[] @relation("CounsellorSessions")
  admissionApplications AdmissionApplication[]
  studentDocuments StudentDocument[]
  feeInvoices FeeInvoice[]
  paymentTransactions PaymentTransaction[]
  commissionRecords CommissionRecord[] @relation("CommissionOwner")
  approvedCommissions CommissionRecord[] @relation("CommissionApprover")
  referrals Referral[]
  enrollmentLogs EnrollmentLog[]
  communicationLogs CommunicationLog[]
  leadActivities LeadActivity[]
  leadNotes LeadNote[]
  attendanceSessions AttendanceSession[] @relation("AttendanceTrainer")
  attendanceRecords AttendanceRecord[] @relation("AttendanceStudent")
  trainerFeedbackGiven TrainerFeedback[] @relation("TrainerFeedbackTrainer")
  trainerFeedbackReceived TrainerFeedback[] @relation("TrainerFeedbackStudent")
  reviewComments ReviewComment[] @relation("ReviewCommentTrainer")
  trainerResources Resource[] @relation("TrainerResources")
  trainerAnnouncements TrainerAnnouncement[] @relation("TrainerAnnouncements")
  studentConcernsRaised StudentConcern[] @relation("StudentConcernTrainer")
  studentConcerns StudentConcern[] @relation("StudentConcernStudent")
  reviewQueueItems ReviewQueue[] @relation("ReviewQueueTrainer")
  reviewQueueAsStudent ReviewQueue[]
  studentPortfolio StudentPortfolio?
  portfolioProjects PortfolioProject[] @relation("PortfolioProjectStudent")
  approvedPortfolioProjects PortfolioProject[] @relation("PortfolioProjectApprover")
  verifiedSkills VerifiedSkill[] @relation("VerifiedSkillStudent")
  skillVerifierRecords VerifiedSkill[] @relation("VerifiedSkillVerifier")
  certificates Certificate[] @relation("CertificateStudent")
  approvedCertificates Certificate[] @relation("CertificateApprover")
  achievements Achievement[] @relation("AchievementStudent")
  publishedAchievements Achievement[] @relation("AchievementPublisher")
  resumeProfiles ResumeProfile[]
  placementProfile PlacementProfile?
  internships Internship[] @relation("InternshipStudent")
  mentoredInternships Internship[] @relation("InternshipMentor")
  founderProfile FounderProfile?
  careerMilestones CareerMilestone[]
  communityGroupsCreated CommunityGroup[] @relation("CommunityGroupCreator")
  communityMemberships CommunityMembership[]
  communityPosts CommunityPost[]
  communityComments CommunityComment[]
  communityReactions CommunityReaction[]
  eventRegistrations EventRegistration[]
  challengeParticipations ChallengeParticipation[]
  wallet Wallet?
  walletTransactions WalletTransaction[] @relation("WalletTransactionActor")
  marketplaceListings MarketplaceListing[] @relation("MarketplaceSeller")
  marketplaceApprovals MarketplaceApproval[] @relation("MarketplaceApprover")
  alumniProfile AlumniProfile?
  missionCompletions MissionCompletion[]
  employeeProfile Employee?
  activationProfile StudentActivationProfile?
  executiveReports ExecutiveReport[] @relation("ExecutiveReportCreator")
  executiveInsights ExecutiveInsight[] @relation("ExecutiveInsightOwner")
  platformAudits PlatformAudit[] @relation("PlatformAuditActor")
  studentLoginCredentials StudentLoginCredential[] @relation("StudentLoginCredentials")
  generatedStudentCredentials StudentLoginCredential[] @relation("GeneratedStudentCredentials")
  whatsAppMessageLogs WhatsAppMessageLog[]

  @@index([email])
  @@index([deletedAt])
}

model Program {
  id           String        @id @default(uuid()) @db.Uuid
  institutionId String?      @db.Uuid
  campusId     String?       @db.Uuid
  departmentId String?       @db.Uuid
  name         String        @db.VarChar(160)
  slug         String        @unique @db.VarChar(180)
  description  String       @db.Text
  durationDays Int
  status       ContentStatus @default(DRAFT)
  thumbnail    String?       @db.VarChar(500)
  category     String?       @db.VarChar(120)
  feeType      ProgramFeeType @default(PAID)
  admissionStatus ProgramAdmissionStatus @default(CLOSED)
  displayOrder Int           @default(0)
  publicVisible Boolean      @default(false)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  journeys      Journey[]
  batches       Batch[]
  enrollments   StudentEnrollment[]
  announcements Announcement[]
  blueprints    Blueprint[]
  contentLibraryItems ContentLibrary[]
  calendarEvents CalendarEvent[]
  directorAnnouncements DirectorAnnouncement[]
  leads Lead[]
  admissionApplications AdmissionApplication[]
  feeInvoices FeeInvoice[]
  commissionRecords CommissionRecord[]
  referrals Referral[]
  certificates Certificate[]
  portfolioPrograms StudentPortfolioProgram[]
  communityGroups CommunityGroup[]
  communityPosts CommunityPost[]
  communityEvents Event[]
  challenges Challenge[]
  missions Mission[]
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([status])
  @@index([admissionStatus, publicVisible])
  @@index([displayOrder])
  @@index([institutionId])
  @@index([campusId])
  @@index([departmentId])
}

model Journey {
  id          String        @id @default(uuid()) @db.Uuid
  programId   String        @db.Uuid
  name        String        @db.VarChar(160)
  description String        @db.Text
  version     Int           @default(1)
  status      ContentStatus @default(DRAFT)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  program      Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  phases       JourneyPhase[]
  enrollments  StudentEnrollment[]
  announcements Announcement[]
  blueprints    Blueprint[]
  calendarEvents CalendarEvent[]
  batches      Batch[]

  @@unique([programId, version])
  @@index([programId, status])
}

model JourneyPhase {
  id          String   @id @default(uuid()) @db.Uuid
  journeyId   String   @db.Uuid
  title       String   @db.VarChar(160)
  order       Int
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  journey Journey       @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  weeks   JourneyWeek[]

  @@unique([journeyId, order])
  @@index([journeyId])
}

model JourneyWeek {
  id         String   @id @default(uuid()) @db.Uuid
  phaseId    String   @db.Uuid
  weekNumber Int
  title      String   @db.VarChar(160)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  phase JourneyPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  days  JourneyDay[]

  @@unique([phaseId, weekNumber])
  @@index([phaseId])
}

model JourneyDay {
  id         String               @id @default(uuid()) @db.Uuid
  weekId     String               @db.Uuid
  dayNumber  Int
  title      String               @db.VarChar(180)
  summary    String?              @db.Text
  unlockType JourneyDayUnlockType @default(SEQUENTIAL)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  week       JourneyWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  activities Activity[]
  learningFlowId String? @db.Uuid
  learningFlow LearningFlow? @relation(fields: [learningFlowId], references: [id], onDelete: SetNull)
  dailyLearningSessions DailyLearningSession[]
  reflections Reflection[]
  submissions Submission[]
  quizAttempts QuizAttempt[]
  assessmentResults AssessmentResult[]

  @@unique([weekId, dayNumber])
  @@index([weekId])
  @@index([dayNumber])
  @@index([learningFlowId])
}

model Activity {
  id          String       @id @default(uuid()) @db.Uuid
  dayId       String       @db.Uuid
  title       String       @db.VarChar(180)
  type        ActivityType
  description String?      @db.Text
  duration    Int?
  sortOrder   Int
  required    Boolean      @default(true)
  points      Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  day      JourneyDay        @relation(fields: [dayId], references: [id], onDelete: Cascade)
  progress StudentProgress[]
  learningSteps LearningStep[]
  submissions Submission[]
  quizQuestions QuizQuestion[]
  quizAttempts QuizAttempt[]
  assessmentResults AssessmentResult[]

  @@unique([dayId, sortOrder])
  @@index([dayId])
  @@index([type])
}

model Batch {
  id        String        @id @default(uuid()) @db.Uuid
  programId String        @db.Uuid
  campusId  String?       @db.Uuid
  journeyId String?       @db.Uuid
  name      String        @db.VarChar(160)
  startsAt  DateTime?
  endsAt    DateTime?
  enrollmentLimit Int?
  status    ContentStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  program       Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  journey       Journey?            @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  enrollments   StudentEnrollment[]
  announcements Announcement[]
  trainerAssignments TrainerAssignment[]
  calendarEvents CalendarEvent[]
  directorAnnouncements DirectorAnnouncement[]
  counsellingSessions CounsellingSession[]
  feeInvoices FeeInvoice[]
  enrollmentLogs EnrollmentLog[]
  attendanceSessions AttendanceSession[]
  attendanceRecords AttendanceRecord[]
  resources Resource[]
  trainerAnnouncements TrainerAnnouncement[]
  studentConcerns StudentConcern[]
  reviewQueueItems ReviewQueue[]
  communityGroups CommunityGroup[]
  communityPosts CommunityPost[]
  communityEvents Event[]
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@index([programId])
  @@index([campusId])
  @@index([journeyId])
  @@index([status])
}

model StudentEnrollment {
  id           String           @id @default(uuid()) @db.Uuid
  studentId    String           @db.Uuid
  programId    String           @db.Uuid
  journeyId    String           @db.Uuid
  batchId      String?          @db.Uuid
  currentDay   Int              @default(1)
  startedAt    DateTime         @default(now())
  completedAt  DateTime?
  status       EnrollmentStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  student User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program Program  @relation(fields: [programId], references: [id], onDelete: Restrict)
  journey Journey  @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  batch   Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  enrollmentLogs EnrollmentLog[]

  @@unique([studentId, programId, journeyId])
  @@index([studentId, status])
  @@index([programId])
  @@index([journeyId])
  @@index([batchId])
}

model StudentActivationProfile {
  id            String   @id @default(uuid()) @db.Uuid
  studentId     String   @unique @db.Uuid
  whatsapp      String?  @db.VarChar(40)
  city          String?  @db.VarChar(120)
  state         String?  @db.VarChar(120)
  educationOrWork String? @db.VarChar(180)
  learningGoal  String?  @db.Text
  preferredLanguage String? @db.VarChar(80)
  availability  String? @db.VarChar(160)
  guardianName  String? @db.VarChar(160)
  guardianPhone String? @db.VarChar(40)
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([completedAt])
}

model StudentProgress {
  id          String         @id @default(uuid()) @db.Uuid
  studentId   String         @db.Uuid
  activityId  String         @db.Uuid
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  score       Int?
  reflection  String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([studentId, activityId])
  @@index([studentId, status])
  @@index([activityId])
}

model Announcement {
  id          String               @id @default(uuid()) @db.Uuid
  authorId    String?              @db.Uuid
  programId   String?              @db.Uuid
  journeyId   String?              @db.Uuid
  batchId     String?              @db.Uuid
  title       String               @db.VarChar(180)
  message     String               @db.Text
  audience    AnnouncementAudience @default(ALL)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  author  User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  program Program? @relation(fields: [programId], references: [id], onDelete: Cascade)
  journey Journey? @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  batch   Batch?   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([audience])
  @@index([programId])
  @@index([batchId])
  @@index([publishedAt])
}

model Blueprint {
  id          String          @id @default(uuid()) @db.Uuid
  programId   String          @db.Uuid
  journeyId   String?         @db.Uuid
  name        String          @db.VarChar(180)
  description String?         @db.Text
  status      BlueprintStatus @default(DRAFT)
  activeVersion Int           @default(1)
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  archivedAt  DateTime?

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  journey Journey? @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  versions BlueprintVersion[]

  @@index([programId, status])
  @@index([journeyId])
}

model BlueprintVersion {
  id          String          @id @default(uuid()) @db.Uuid
  blueprintId String          @db.Uuid
  version     Int
  title       String          @db.VarChar(180)
  notes       String?         @db.Text
  status      BlueprintStatus @default(DRAFT)
  sourceVersionId String?     @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@unique([blueprintId, version])
  @@index([blueprintId, status])
}

model ContentLibrary {
  id          String             @id @default(uuid()) @db.Uuid
  programId   String?            @db.Uuid
  uploadedById String?           @db.Uuid
  title       String             @db.VarChar(180)
  type        ContentLibraryType
